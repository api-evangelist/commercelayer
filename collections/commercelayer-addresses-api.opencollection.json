                "description": "The resource unique identifier."
              }
            ]
          },
          "docs": "Update an address"
        },
        {
          "info": {
            "name": "Delete an address",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{organization}.commercelayer.io/api/addresses/:addressId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource unique identifier."
              }
            ]
          },
          "docs": "Delete an address"
        }
