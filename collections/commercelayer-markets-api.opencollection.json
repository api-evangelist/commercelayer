                "description": "The resource unique identifier."
              }
            ]
          },
          "docs": "Update a market"
        },
        {
          "info": {
            "name": "Delete a market",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{organization}.commercelayer.io/api/markets/:marketId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource unique identifier."
              }
            ]
          },
          "docs": "Delete a market"
        }
      ]
    }
