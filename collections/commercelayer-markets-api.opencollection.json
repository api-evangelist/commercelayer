{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer Core Addresses Markets API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Markets",
        "type": "folder"
      },
      "items": [
