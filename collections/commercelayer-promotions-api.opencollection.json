{
  "opencollection": "1.0.0",
  "info": {
    "name": "Commerce Layer Core Addresses Promotions API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Promotions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all promotions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.commercelayer.io/api/promotions"
          },
          "docs": "List all promotions"
        },
        {
          "info": {
            "name": "Retrieve a promotion",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.commercelayer.io/api/promotions/:promotionId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The resource unique identifier."
              }
            ]
          },
          "docs": "Retrieve a promotion"
        }
      ]
    }
  ],
  "bundled": true
}