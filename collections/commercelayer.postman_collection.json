            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "List all addresses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/vnd.api+json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": ["{{baseUrl}}"],
              "path": ["addresses"]
            }
          }
        }
      ]
    },
    {
      "name": "Shipments",
      "item": [
        {
          "name": "List all shipments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/vnd.api+json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": ["{{baseUrl}}"],
              "path": ["shipments"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "List all payment methods",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/vnd.api+json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/payment_methods",
              "host": ["{{baseUrl}}"],
              "path": ["payment_methods"]
            }
          }
        }
      ]
    },
    {
      "name": "Markets",
      "item": [
        {
          "name": "List all markets",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/vnd.api+json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/markets",
              "host": ["{{baseUrl}}"],
              "path": ["markets"]
            }
          }
        }
      ]
    },
    {
      "name": "Promotions",
      "item": [
        {
          "name": "List all promotions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/vnd.api+json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/promotions",
              "host": ["{{baseUrl}}"],
              "path": ["promotions"]
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "List all webhooks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/vnd.api+json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks"]
            }
          }
        },
        {
          "name": "Create a webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/vnd.api+json" },
              { "key": "Accept", "value": "application/vnd.api+json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"type\": \"webhooks\",\n    \"attributes\": {\n      \"topic\": \"orders.place\",\n      \"callback_url\": \"\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks"]
            }
          }
        }
      ]
    }
  ]
}
